{
  "profile_id": "predictive-maintenance-vp-regulated-line-enterprise",
  "version": 1,
  "solution": "S-8",
  "industry": "equipment rental",
  "persona": {
    "role": "VP, regulated line",
    "context": "Answers to a regulator and a reinsurer.",
    "measured_on": [
      "cycle time",
      "leakage"
    ],
    "constraints": [
      "Must be able to explain any individual decision on request.",
      "No decision may be taken without a named human approving that instance."
    ]
  },
  "connections": [
    {
      "name": "fleet_pg",
      "kind": "postgres",
      "state": "captured"
    },
    {
      "name": "telemetry_s3",
      "kind": "s3",
      "state": "discovered"
    }
  ],
  "tables": [
    {
      "database": "fleet",
      "name": "assets",
      "rows": 21000,
      "records": "records/fleet.assets.jsonl",
      "columns": [
        "acquired_at",
        "asset_id",
        "depot_id",
        "model",
        "year"
      ]
    },
    {
      "database": "fleet",
      "name": "work_orders",
      "rows": 152500,
      "records": "records/fleet.work_orders.jsonl",
      "columns": [
        "asset_id",
        "closed_at",
        "fault_code",
        "is_breakdown",
        "labour_hours",
        "opened_at",
        "work_order_id"
      ]
    }
  ]
}