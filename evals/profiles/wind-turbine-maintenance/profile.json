{
  "profile_id": "wind-turbine-maintenance",
  "industry": "Wind Energy",
  "situation": "markdown: A wind energy company needs to improve predictive maintenance for their wind turbines to minimize downtime and extend the lifespan of their equipment. The maintenance manager is responsible for ensuring turbines operate smoothly and safely. They are measured on reducing unplanned outages and increasing turbine uptime percentage.",
  "persona": {
    "role": "Maintenance Manager",
    "context": "Responsible for overseeing all maintenance activities related to wind turbines.",
    "measured_on": [
      "Turbine uptime percentage",
      "Number of unplanned outages"
    ],
    "constraints": [
      "Budget constraints for new equipment",
      "Limited skilled technicians"
    ]
  },
  "connections": [
    {
      "name": "turbine_sensors_data",
      "kind": "s3",
      "state": "captured"
    },
    {
      "name": "maintenance_logs",
      "kind": "rest",
      "state": "discovered"
    }
  ],
  "tables": [
    {
      "database": "wind_energy",
      "name": "turbine_operations",
      "connection": "turbine_sensors_data",
      "rows": 200000,
      "columns": [
        {
          "name": "turbine_id",
          "type": "string",
          "null_fraction": 0.0
        },
        {
          "name": "timestamp",
          "type": "timestamp",
          "null_fraction": 0.0
        },
        {
          "name": "vibration_level",
          "type": "float",
          "null_fraction": 0.1
        },
        {
          "name": "temperature",
          "type": "float",
          "null_fraction": 0.05
        },
        {
          "name": "wind_speed",
          "type": "float",
          "null_fraction": 0.0
        },
        {
          "name": "power_output",
          "type": "float",
          "null_fraction": 0.02
        }
      ],
      "records_sampled": 50000
    },
    {
      "database": "wind_energy",
      "name": "maintenance_records",
      "connection": "maintenance_logs",
      "rows": 10000,
      "columns": [
        {
          "name": "turbine_id",
          "type": "string",
          "null_fraction": 0.0
        },
        {
          "name": "maintenance_date",
          "type": "timestamp",
          "null_fraction": 0.0
        },
        {
          "name": "maintenance_type",
          "type": "string",
          "null_fraction": 0.01
        },
        {
          "name": "duration_hours",
          "type": "int",
          "null_fraction": 0.0
        },
        {
          "name": "technician_id",
          "type": "string",
          "null_fraction": 0.05
        }
      ]
    }
  ]
}