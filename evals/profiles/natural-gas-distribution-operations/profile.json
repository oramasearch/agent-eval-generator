      "Network efficiency",
      "Pipeline maintenance costs",
      "Customer satisfaction"
    ],
    "constraints": [
      "Budget for infrastructure improvements is limited and needs justification through data",
      "Maintenance windows are limited to non-peak hours",
      "Need to coordinate with local authorities for emergency response plans"
    ]
