{
  "profile_id": "predictive-maintenance-chief-operating-officer-smb",
  "version": 1,
  "solution": "S-8",
  "industry": "equipment rental",
  "persona": {
    "role": "Chief Operating Officer",
    "context": "Reads one number a week; delegates the rest.",
    "measured_on": [
      "margin",
      "on-time delivery"
    ],
    "constraints": [
      "Will only act on something that names the single account or asset to touch."
    ]
  },
  "connections": [
    {
      "name": "fleet_pg",
      "kind": "postgres",
      "state": "captured"
