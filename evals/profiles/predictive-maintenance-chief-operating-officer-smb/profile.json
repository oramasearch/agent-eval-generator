      "kind": "s3",
      "state": "discovered"
    }
  ],
  "tables": [
    {
      "database": "fleet",
      "name": "assets",
      "rows": 2520,
      "records": "records/fleet.assets.jsonl",
      "columns": [
        "acquired_at",
        "asset_id",
        "depot_id",
        "model",
        "year"
      ]
    },
    {
      "database": "fleet",
      "name": "work_orders",
      "rows": 18300,
      "records": "records/fleet.work_orders.jsonl",
      "columns": [
        "asset_id",
        "closed_at",
        "fault_code",
        "is_breakdown",
        "labour_hours",
        "opened_at",
        "work_order_id"
      ]
    }
